<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <ItemGroup>
        <!-- Sitecore builtin assemblies -->
        <SitecoreAssembliesToExclude Include="@(SitecoreAssemblies)" />

        <!-- Deployment project -->
        <SitecoreAssembliesToExclude Include="ISC2.Environment.Sitecore.dll" />
        <SitecoreAssembliesToExclude Include="Sitecore.LayoutService.dll" />
        <SitecoreAssembliesToExclude Include="Sitecore.LayoutService.Mvc.dll" />
    </ItemGroup>
	<PropertyGroup>
		<AutoPublish Condition="'$(AutoPublish)' == '' and '$(PublishProfile)' != ''">true</AutoPublish>

		<AutoPublishDependsOn Condition="'$(AutoPublish)' == 'true'">
			$(AutoPublishDependsOn);
			WebPublish
		</AutoPublishDependsOn>
	</PropertyGroup>

	<Target Name="AutoPublish" AfterTargets="Build" DependsOnTargets="$(AutoPublishDependsOn)">
	</Target>
</Project>