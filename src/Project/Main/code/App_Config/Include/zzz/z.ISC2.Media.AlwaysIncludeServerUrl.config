<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <settings>
      <!--
        Disable absolute URLs for media items.
        This forces Sitecore to return relative paths (e.g. /-/media/...),
        which helps avoid domain mismatches across environments (DEV/QA/PROD).
      -->
      <setting name="Media.AlwaysIncludeServerUrl" value="false" />
    </settings>
  </sitecore>
</configuration>