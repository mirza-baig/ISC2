<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/" xmlns:search="http://www.sitecore.net/xmlconfig/search/">
	<sitecore >
		<scheduling>
			<!-- Auto Publish Agent for master to web -->
			<agent name="PublishAgent.Web" method="Run" interval="00:00:00" type="Sitecore.Tasks.PublishAgent" role:require="ContentManagement">
				<param desc="source database">master</param>
				<param desc="target database">web</param>
				<param desc="mode (full or smart or incremental)">incremental</param>
				<param desc="languages">en</param>
			</agent>
		</scheduling>
	</sitecore>
</configuration>