            "fields": {
                "appreciationMessage": {
                    "value": "<p>Your order details are below, and an email has been sent to {userEmail} with your purchase information.</p>\n\n<p>To start a course, review your order history or download invoices, log in to <a href=\"/dashboard\" class=\"border-b\" style=\"border-style: dotted; color: rgb(34 124 180); border-color: rgb(34 124 180);\">www.isc2.org/dashboard</a>. If you paid AMF or Candidate dues, it may take several minutes for your payment to be reflected in your dashboard.<br /><br />\n\n<a href=\"/dashboard\" class=\"primary-cta\">Open Dashboard</a></p>"
                },
                "labelsTooltipsAndMore": {
                    "value": "printOrderCtaLabel=Print%20Your%20Order&appreciationMessageHeadline=Thank%20You%20for%20Your%20Purchase&providedByLabel=Provided%20by%20ISC2&shippingSectionTitle=Shipping&companySectionTitle=Company&paymentSectionTitle=Payment&paymentWaitingApprovalNotice=Waiting%20for%20payment%20approval&orderNumberCopy=Order%20%23%7BorderId%7D"
                },
                "checkoutErrorMessage": {
                    "value": "<div class=\"flex w-full flex-col pt-10\">\n<div class=\"rich-text-block flex flex-col bg-transparent px-5 text-black-100 sm:px-16\">\n<div class=\"rich-text slider-scrollbar cursor-auto text-center\">\n<h2 class=\"pb-27\" style=\"font-size: 2.5rem;\">There was an error with your order.</h2>\n<h2 class=\"pb-27\" style=\"font-size: 2.5rem;\">Please return to your cart at <a href=\"https://www.isc2.org/Checkout\">https://www.isc2.org/Checkout</a> and try again.</h2>\n<p style=\"padding-bottom: 0;\">If you reach this error message again after retrying to place your order, <a href=\"https://www.isc2.org/contact-us\">contact us</a>.</p>\n</div></div></div>"
                },
                "purchaseConfirmationCopy": {
                    "value": "<p><strong>Important:</strong> After purchasing, exam takers will register for and schedule their exam via the <a href=\"/dashboard\" class=\"border-b\" style=\"border-style: dotted; color: rgb(34 124 180); border-color: rgb(34 124 180);\">ISC2 Dashboard</a>.</p>\n\n<p>Learn what you need to know about certification exams every step of the way <a href=\"/exams\" class=\"border-b\" style=\"border-style: dotted; color: rgb(34 124 180); border-color: rgb(34 124 180);\">here</a>.</p>"
                }
            },
