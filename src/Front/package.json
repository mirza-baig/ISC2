    "algoliasearch": "^4.17.1",
    "axios": "^1.16.1",
    "bootstrap": "^5.1.3",
    "clsx": "^1.2.1",
    "cookies-next": "^2.1.1",
    "country-to-currency": "^1.1.5",
    "date-fns": "^3.6.0",
    "font-awesome": "^4.7.0",
    "graphql": "~15.8.0",
    "graphql-tag": "^2.12.6",
