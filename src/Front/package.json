    "react-hook-form": "^7.54.2",
    "react-instantsearch-dom": "^6.40.0",
    "react-instantsearch-hooks-web": "^6.44.0",
    "react-select": "^5.8.0",
    "react-viewport-list": "^7.1.2",
    "react-youtube": "^10.1.0",
